# Imagen de ejecución de ai-course-notes: la base de thyrox más lo que el call
# path de los verificadores deterministas (V0–V6) de ES_MX_TRANSLATION_PLAN.md
# invoca, y nada más. Derivado, no supuesto:
#
#   check_prose_vocabulary.py      -> hunspell (el diccionario es del repositorio:
#                                     tools/lang/es-mx/hunspell/es_MX)
#   translation_loop.py (V5)       -> xelatex con los paquetes que declara
#                                     tools/lib/toolchain.sh::NOTES_TEXLIVE_PACKAGES
#   preámbulo localizado           -> FandolSong (texlive-lang-chinese) y
#                                     WenQuanYi Zen Hei (fonts-wqy-zenhei)
#
# V7 (render_pdf_qa.py: pdftoppm, magick, mutool) es revisión visual por
# muestreo y no entra. `parallel` ya lo trae la base.
ARG BASE_IMAGE=localhost/thyrox-task-runner:dev
FROM ${BASE_IMAGE}
ARG HTTPS_PROXY
ARG https_proxy
ARG PROXY_CA
RUN apt-get update \
 && apt-get install -y --no-install-recommends hunspell \
      texlive-xetex texlive-latex-extra texlive-pictures texlive-fonts-recommended \
      texlive-lang-chinese texlive-lang-spanish lmodern fonts-wqy-zenhei \
 && rm -rf /var/lib/apt/lists/*
