#!/usr/bin/env bash
# tools/thyrox/run — invoca un comando de `$THYROX_ROOT/bin/` con el entorno
# de este consumer.
#
#   tools/thyrox/run <comando> [argumentos...]
#   tools/thyrox/run --print-env     el entorno que se exportaria
#   tools/thyrox/run --list          los comandos que ofrece THYROX
#
# Codigos de salida: los del comando invocado; 2 si falta una precondicion.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

usage() {
    sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
    ""|-h|--help) usage; exit 0 ;;
esac

thyrox_prepare_env || exit $?

case "$1" in
    --print-env)
        printf '%s=%s\n' \
            THYROX_ROOT "$THYROX_ROOT" \
            THYROX_ENV_FILE "$THYROX_ENV_FILE" \
            VOCAB_GATE_ROOT "$VOCAB_GATE_ROOT" \
            VOCAB_GATE_BASELINE "$VOCAB_GATE_BASELINE"
        exit 0 ;;
    --list)
        ls "$THYROX_ROOT/bin"
        exit 0 ;;
esac

command_name="$1"
shift
target="$THYROX_ROOT/bin/$command_name"
if [[ "$command_name" == */* || ! -x "$target" ]]; then
    thyrox_refuse "'$command_name' no es un comando de $THYROX_ROOT/bin (ver --list)."
    exit 2
fi

# Este consumer no tiene store de agentes. Los comandos que leen o escriben uno
# caerian, sin THYROX_AGENT_STORE declarada, al store de THYROX
# (`reach.agent_store_path()`, H-THYROX-178), que es un ejemplo del mecanismo y
# no se llena desde aqui. Se niegan en vez de continuar; declarar
# THYROX_AGENT_STORE en el `.env` del consumer los habilita contra ese store.
case "$command_name" in
    agent_store|task_ids|hallazgo_ids)
        if [[ -z "${THYROX_AGENT_STORE:-$(thyrox_env_value "$THYROX_ENV_FILE" THYROX_AGENT_STORE)}" ]]; then
            thyrox_refuse "$command_name usa el store de agentes y este consumer no declara uno (THYROX_AGENT_STORE en $THYROX_ENV_FILE); sin el, escribiria o leeria el store de THYROX."
            exit 2
        fi ;;
esac

exec "$target" "$@"
