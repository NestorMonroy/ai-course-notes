#!/usr/bin/env bash
# tools/thyrox/run — invoca un comando de `$THYROX_ROOT/bin/` con el entorno
# de este consumer.
#
#   tools/thyrox/run <comando> [argumentos...]
#   tools/thyrox/run --print-env     el entorno que se exportaria
#   tools/thyrox/run --list          los comandos que ofrece THYROX
#
# Codigos de salida: los del comando invocado; 2 si falta una precondicion.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

usage() {
    sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
    ""|-h|--help) usage; exit 0 ;;
esac

thyrox_prepare_env || exit $?

case "$1" in
    --print-env)
        printf '%s=%s\n' \
            THYROX_ROOT "$THYROX_ROOT" \
            THYROX_ENV_FILE "$THYROX_ENV_FILE" \
            VOCAB_GATE_ROOT "$VOCAB_GATE_ROOT" \
            VOCAB_GATE_BASELINE "$VOCAB_GATE_BASELINE"
        exit 0 ;;
    --list)
        ls "$THYROX_ROOT/bin"
        exit 0 ;;
esac

command_name="$1"
shift
target="$THYROX_ROOT/bin/$command_name"
if [[ "$command_name" == */* || ! -x "$target" ]]; then
    thyrox_refuse "'$command_name' no es un comando de $THYROX_ROOT/bin (ver --list)."
    exit 2
fi

# `agent_store --repo` compone `<prefijo><repo>` y `.claude/agent-results`, aunque
# el clon no lleve el prefijo (H-THYROX-177): apuntaria a un directorio que no
# existe. El store del consumer se resuelve por THYROX_AGENT_STORE en su `.env`.
if [[ "$command_name" == "agent_store" ]]; then
    for arg in "$@"; do
        if [[ "$arg" == "--repo" || "$arg" == --repo=* ]]; then
            thyrox_refuse "agent_store --repo no aplica a este consumer (H-THYROX-177); el store sale de THYROX_AGENT_STORE en $THYROX_ENV_FILE."
            exit 2
        fi
    done
fi

exec "$target" "$@"
