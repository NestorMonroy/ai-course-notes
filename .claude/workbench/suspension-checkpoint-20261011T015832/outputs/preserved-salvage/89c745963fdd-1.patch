+import { retireDataset } from '../datasetMaterialization.js';
+
+// Helper to create a DatasetPublicationRecord
+function createRecord(title, status = 'verified') {
+  return {
+    title,
+    status,
+    // Simulate a record with a file path and SHA256
+    file: {
+      path: `/tmp/${title}.txt`,
+      sha256: 'sha256:' + Buffer.from(title, 'utf8').toString('hex')
+    },
+    // Simulate a pinned copy
+    pinnedCopy: {
+      blobDigest: 'sha256:' + Buffer.from(title, 'utf8').toString('hex')
+    }
+  };
+}
+
+// Test 1: File matches record, verifyRemote resolves true, isInUse resolves false
+async function test1() {
+  const record = createRecord('test1', 'verified');
+  const verifyRemote = jest.fn().mockResolvedValue(true);
+  const isInUse = jest.fn().mockResolvedValue(false);
+  
+  const result = await retireDataset({
+    path: record.file.path,
+    record,
+    title: record.title,
+    verifyRemote,
+    isInUse
+  });
+  
+  expect(result.status).toBe('retired');
+  expect(result.reclaimedBytes).toBe(1024);
+  expect(verifyRemote).toHaveBeenCalledWith(record.pinnedCopy.blobDigest);
+  expect(isInUse).toHaveBeenCalledWith(record.file.path);
+}
+
+// Test 2: Record is not verified
+async function test2() {
+  const record = createRecord('test2', 'unverified');
+  const verifyRemote = jest.fn().mockResolvedValue(true);
+  const isInUse = jest.fn().mockResolvedValue(false);
+  
+  const result = await retireDataset({
+    path: record.file.path,
+    record,
+    title: record.title,
+    verifyRemote,
+    isInUse
+  });
+  
+  expect(result.status).toBe('refused');
+  expect(result.reclaimedBytes).toBe(0);
+  expect(verifyRemote).not.toHaveBeenCalled();
+  expect(isInUse).not.toHaveBeenCalled();
+}
+
+// Test 3: File content differs from record
+async function test3() {
+  const record = createRecord('test3', 'verified');
+  const verifyRemote = jest.fn().mockResolvedValue(true);
+  const isInUse = jest.fn().mockResolvedValue(false);
+  
+  // Simulate a file with different content
+  const fs = require('fs');
+  fs.writeFileSync(record.file.path, 'different content');
+  
+  const result = await retireDataset({
+    path: record.file.path,
+    record,
+    title: record.title,
+    verifyRemote,
+    isInUse
+  });
+  
+  expect(result.status).toBe('refused');
+  expect(result.reclaimedBytes).toBe(0);
+  expect(verifyRemote).toHaveBeenCalledWith(record.pinnedCopy.blobDigest);
+  expect(isInUse).toHaveBeenCalledWith(record.file.path);
+}
+
+// Test 4: verifyRemote resolves false
+async function test4() {
+  const record = createRecord('test4', 'verified');
+  const verifyRemote = jest.fn().mockResolvedValue(false);
+  const isInUse = jest.fn().mockResolvedValue(false);
+  
+  const result = await retireDataset({
+    path: record.file.path,
+    record,
+    title: record.title,
+    verifyRemote,
+    isInUse
+  });
+  
+  expect(result.status).toBe('refused');
+  expect(result.reclaimedBytes).toBe(0);
+  expect(verifyRemote).toHaveBeenCalledWith(record.pinnedCopy.blobDigest);
+  expect(isInUse).toHaveBeenCalledWith(record.file.path);
+}
+
+// Test 5: isInUse resolves true
+async function test5() {
+  const record = createRecord('test5', 'verified');
+  const verifyRemote = jest.fn().mockResolvedValue(true);
+  const isInUse = jest.fn().mockResolvedValue(true);
+  
+  const result = await retireDataset({
+    path: record.file.path,
+    record,
+    title: record.title,
+    verifyRemote,
+    isInUse
+  });
+  
+  expect(result.status).toBe('refused');
+  expect(result.reclaimedBytes).toBe(0);
+  expect(verifyRemote).toHaveBeenCalledWith(record.pinnedCopy.blobDigest);
+  expect(isInUse).toHaveBeenCalledWith(record.file.path);
+}
+
+// Run tests
+test1();
+test2();
+test3();
+test4();
+test5();
