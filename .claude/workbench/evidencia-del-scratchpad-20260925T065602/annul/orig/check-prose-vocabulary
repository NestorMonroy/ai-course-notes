#!/usr/bin/env bash
# tools/thyrox/check-prose-vocabulary — el gate de vocabulario de THYROX
# (`check_vocabulario_prosa`) sobre la prosa en espanol de este consumer.
#
#   tools/thyrox/check-prose-vocabulary [archivo...]
#
# Sin argumentos, el alcance son los `.tex` nuevos o modificados contra
# PROSE_BASE_REF (default: es-mx), incluidos los que aun no estan en git.
#
# Codigos de salida: 0 sin hallazgos nuevos, 1 con hallazgos, 2 si no se pudo
# medir. Que mide y que no: tools/thyrox/README.md.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
thyrox_prepare_env || exit $?

consumer="$VOCAB_GATE_ROOT"
files=()

if (( $# > 0 )); then
    # Rutas absolutas antes de cambiar de directorio: el usuario las escribio
    # relativas a su cwd, no a la raiz del consumer.
    for file in "$@"; do
        files+=("$(realpath -m -- "$file")")
    done
else
    base="${PROSE_BASE_REF:-es-mx}"
    if ! git -C "$consumer" rev-parse --verify -q "${base}^{commit}" >/dev/null; then
        thyrox_refuse "la referencia base '$base' no existe; declara PROSE_BASE_REF o pasa los archivos."
        exit 2
    fi
    # Tres fuentes: lo commiteado en la rama, lo modificado sin commitear y
    # lo nuevo sin seguimiento. Solo la primera omitiria el trabajo en curso.
    while IFS= read -r file; do
        [[ -n "$file" ]] && files+=("$consumer/$file")
    done < <({
        git -C "$consumer" diff --name-only --diff-filter=AMR "${base}...HEAD" -- '*.tex'
        git -C "$consumer" diff --name-only --diff-filter=AMR HEAD -- '*.tex'
        git -C "$consumer" ls-files --others --exclude-standard -- '*.tex'
    } | sort -u)

    if (( ${#files[@]} == 0 )); then
        # Un alcance vacio se declara como tal; no se invoca el gate, que sin
        # argumentos mediria su corpus por defecto (`source/**.rst`).
        echo "check-prose-vocabulary: alcance medido: 0 archivo(s) .tex nuevos o modificados contra $base; el gate no se invoca."
        exit 0
    fi
fi

cd "$consumer"
exec "$(dirname "${BASH_SOURCE[0]}")/run" check_vocabulario_prosa --strict "${files[@]}"
